@page "/account/reset-password"
@layout OnboardingLayout
@implements IDisposable
@inject ScenarioSelection ScenarioSelection
@inject ResetPasswordScenarioProvider ScenarioProvider
@inject IStringLocalizer<IdentityResources> Localizer
@inject IStringLocalizer<BeeDayLab.Web.Resources.SharedResources> SharedLocalizer

@* Lab adaptation (Sprint 33.12, FE33-084) of BeeDay.Web's
   Components/Features/Identity/Pages/ResetPassword.razor. @attribute [AllowAnonymous] dropped. The
   real ISender.Send(ResetPasswordCommand) call is replaced with a fixed Task.Delay followed by
   ResetPasswordScenarioProvider.GetScenario(ScenarioSelection.Context). The
   [SupplyParameterFromQuery(Name="token")] presence check is kept exactly as production has it — it
   is pure input-validation/presentation logic (does the URL even carry a token), not a backend
   dependency, same "keep alongside the scenario engine" treatment ConfirmEmail.razor's own token
   parameter gets. DomainErrorLocalizer.Translate(ex, SharedLocalizer) is replaced on failure with
   SharedLocalizer["DomainErrorGeneric"], same reasoning as ResendConfirmation.razor. *@

<PageTitle>@Localizer["ResetPasswordPageTitle"]</PageTitle>
<section class="identity-page beeday-fade-in"><div class="identity-card"><div class="identity-card__content">
<div class="identity-card__brand"><BeeDayBrand /></div>
@if (_completed) { <header class="identity-header"><h1>@Localizer["PasswordUpdatedHeading"]</h1><p>@Localizer["PasswordUpdatedIntro"]</p></header><div class="identity-feedback identity-feedback--success">@Localizer["PasswordResetCompletedMessage"]</div><a class="identity-navigation-link identity-navigation-link--primary" href="/login?reset=true">@Localizer["SignIn"]</a> }
else { <header class="identity-header"><h1>@Localizer["ResetPasswordHeading"]</h1><p>@Localizer["ResetPasswordIntro"]</p></header>
@if (!string.IsNullOrWhiteSpace(_error)) { <div class="identity-feedback identity-feedback--error" role="alert">@_error</div> }
<EditForm Model="_model" OnValidSubmit="SubmitAsync" class="identity-form"><DataAnnotationsValidator />
<BeeDayInput Id="reset-password" Label="@Localizer["NewPasswordLabel"]" Required="true"
             type="password" autocomplete="new-password" @bind-Value="_model.Password" />
<BeeDayInput Id="reset-password-confirmation" Label="@Localizer["ConfirmPasswordLabel"]" Required="true"
             type="password" autocomplete="new-password" @bind-Value="_model.ConfirmPassword" />
<BeeDayButton Type="submit" FullWidth="true" IsLoading="@_busy" Disabled="@_busy">@Localizer["ResetPasswordButton"]</BeeDayButton></EditForm>
<a class="identity-navigation-link" href="/login">@Localizer["BackToSignIn"]</a> }
</div></div></section>
@code {
    [SupplyParameterFromQuery(Name="token")] public string? Token { get; set; }
    private readonly PasswordForm _model = new(); private bool _busy; private bool _completed; private string? _error;
    private readonly CancellationTokenSource _cts = new();
    public void Dispose() { _cts.Cancel(); _cts.Dispose(); }
    private async Task SubmitAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(Token)) { _error = Localizer["ResetTokenMissingError"]; return; }
        _busy = true;
        try
        {
            await Task.Delay(400, _cts.Token);
            var scenario = ScenarioProvider.GetScenario(ScenarioSelection.Context);
            if (scenario.Succeeds) { _completed = true; } else { _error = SharedLocalizer["DomainErrorGeneric"]; }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested) { }
        finally { _busy = false; }
    }
    private sealed class PasswordForm { [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.MinLength(8)] public string Password { get; set; }=string.Empty; [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.Compare(nameof(Password), ErrorMessage="Passwords do not match.")] public string ConfirmPassword { get; set; }=string.Empty; }
}
