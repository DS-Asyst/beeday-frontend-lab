@page "/account/forgot-password"
@layout OnboardingLayout
@implements IDisposable
@inject ScenarioSelection ScenarioSelection
@inject ForgotPasswordScenarioProvider ScenarioProvider
@inject IStringLocalizer<IdentityResources> Localizer

@* Lab adaptation (Sprint 33.12, FE33-080) of BeeDay.Web's
   Components/Features/Identity/Pages/ForgotPassword.razor. @attribute [AllowAnonymous] dropped — no
   authorization pipeline exists in the Lab. The real ISender.Send(RequestPasswordResetCommand) call
   is replaced with a fixed Task.Delay (preserves the loading-state UX without a real network call)
   followed by ForgotPasswordScenarioProvider.GetScenario(ScenarioSelection.Context) to decide
   success/failure — see Scenarios/ForgotPasswordScenarioData.cs / ForgotPasswordScenarioProvider.cs.
   Production's generic catch-all error message was already a page-owned IdentityResources key
   ("RequestFailedGeneric"), never routed through DomainErrorLocalizer, so this page needed no other
   change to stay error-narrative-faithful. *@

<PageTitle>@Localizer["ForgotPasswordPageTitle"]</PageTitle>
<section class="identity-page beeday-fade-in"><div class="identity-card"><div class="identity-card__content">
<div class="identity-card__brand"><BeeDayBrand /></div>
<header class="identity-header"><h1>@Localizer["ForgotPasswordHeading"]</h1><p>@Localizer["ForgotPasswordIntro"]</p></header>
@if (_submitted) { <div class="identity-feedback identity-feedback--success" role="status">@Localizer["ForgotPasswordSubmittedMessage"]</div><div class="identity-note"><span>@Localizer["ForgotPasswordSameResponseNote"]</span></div> }
@if (_hasError) { <div class="identity-feedback identity-feedback--error" role="alert">@Localizer["RequestFailedGeneric"]</div> }
<EditForm Model="_model" OnValidSubmit="SubmitAsync" class="identity-form"><DataAnnotationsValidator />
<BeeDayInput Id="forgot-password-email" Label="@Localizer["EmailLabel"]" Required="true"
             type="email" autocomplete="email" Disabled="@_busy" @bind-Value="_model.Email" />
<BeeDayButton Type="submit" FullWidth="true" IsLoading="@_busy" Disabled="@_busy">@Localizer["SendRecoveryLink"]</BeeDayButton></EditForm>
<a class="identity-navigation-link" href="/login">@Localizer["BackToSignIn"]</a>
</div></div></section>
@code {
    private readonly EmailForm _model = new(); private bool _busy; private bool _submitted; private bool _hasError;
    private readonly CancellationTokenSource _cts = new();
    public void Dispose() { _cts.Cancel(); _cts.Dispose(); }
    private async Task SubmitAsync()
    {
        if (_busy) return;
        _busy = true; _hasError = false;
        try
        {
            await Task.Delay(400, _cts.Token);
            var scenario = ScenarioProvider.GetScenario(ScenarioSelection.Context);
            if (scenario.Succeeds) { _submitted = true; } else { _hasError = true; }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested) { }
        finally { _busy = false; }
    }
    private sealed class EmailForm { [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.EmailAddress] public string Email { get; set; } = string.Empty; }
}
