@* Lab adaptation (Sprint 33.9, FE33-045): the BeeDay source injects IStringLocalizer<LayoutResources>
   for the drawer's aria-label and its close button's aria-label. The Lab has no localization
   pipeline (Program.cs has no AddLocalization), so these are plain hardcoded English strings
   instead, taken verbatim from LayoutResources.en-US.resx at extraction time. The focus-trap/
   keyboard-handling logic in MobileSidebar.razor.cs (Escape-to-close, focus-on-open) is
   presentation-only and copied verbatim. *@
<div class="mobile-nav-backdrop @(IsOpen ? "is-open" : null)" aria-hidden="true" @onclick="OnClose"></div>

<aside id="mobile-navigation"
       class="mobile-nav-drawer @(IsOpen ? "is-open" : null)"
       aria-label="Primary navigation"
       aria-hidden="@AriaHiddenValue"
       @onkeydown="HandleKeyDown">
    <div class="mobile-nav-drawer__header">
        <NavLink href="/profile" Match="NavLinkMatch.Prefix" class="mobile-nav-drawer__brand" @onclick="HandleNavigate">
            <BeeDayBrand />
        </NavLink>

        <button type="button" class="mobile-nav-drawer__close" aria-label="Close" @onclick="OnClose" @ref="closeButtonElement">
            <BeeDayIcon Name="BeeDayIconName.Close" Size="BeeDayIconSize.Large" />
        </button>
    </div>

    <NavigationItems OnNavigate="HandleNavigate" />
</aside>
