@* Lab adaptation (Sprint 33.8, FE33-030): the BeeDay source injects IStringLocalizer<DesignSystemResources>
   for the default Cancel/Confirm labels (used only when the caller does not supply ConfirmLabel/
   CancelLabel). Dropped for the same reason as BeeDayErrorBoundary/BeeDayLoading — no localization
   pipeline in the Lab — using the verified English defaults as plain string literals instead. *@
@if (IsOpen)
{
    <div class="delete-confirmation-backdrop"
         role="presentation"
         tabindex="-1"
         @onclick="CancelAsync"
         @onkeydown="HandleKeyDownAsync"
         @onkeydown:stopPropagation="true">
        <section class="delete-confirmation"
                 id="@DialogId"
                 role="alertdialog"
                 aria-modal="true"
                 aria-labelledby="@TitleId"
                 aria-describedby="@DescriptionId"
                 aria-busy="@IsBusy.ToString().ToLowerInvariant()"
                 tabindex="-1"
                 @onclick:stopPropagation>
            <div class="delete-confirmation__top-border" aria-hidden="true"></div>
            <div class="delete-confirmation__content">
                <div class="delete-confirmation__icon" aria-hidden="true"><BeeDayIcon Name="BeeDayIconName.Delete" Size="BeeDayIconSize.ExtraLarge" Color="BeeDayIconColor.Danger" /></div>
                <h2 id="@TitleId">@Title</h2>
                <p id="@DescriptionId" class="delete-confirmation__question">@Message</p>

                @if (!string.IsNullOrWhiteSpace(ItemTitle))
                {
                    <p class="delete-confirmation__item-title">"@ItemTitle"</p>
                }

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="delete-confirmation__error" role="alert">
                        <BeeDayIcon Name="BeeDayIconName.Warning" Size="BeeDayIconSize.Small" Color="BeeDayIconColor.Danger" Decorative="true" />
                        <span>@ErrorMessage</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Warning))
                {
                    <div class="delete-confirmation__warning">
                        <BeeDayIcon Name="BeeDayIconName.Warning" Size="BeeDayIconSize.Small" Color="BeeDayIconColor.Danger" Class="delete-confirmation__warning-icon" />
                        <div>
                            <strong>@Warning</strong>
                            @if (!string.IsNullOrWhiteSpace(WarningDetails))
                            {
                                <p>@WarningDetails</p>
                            }
                        </div>
                    </div>
                }

                <div class="delete-confirmation__actions">
                    <BeeDayButton Variant="BeeDayButtonVariant.ConfirmationCancel"
                                   Disabled="IsBusy"
                                   Class="delete-confirmation__cancel-action"
                                   OnClick="CancelAsync">
                        @(CancelLabel ?? "Cancel")
                    </BeeDayButton>
                    <BeeDayButton Variant="BeeDayButtonVariant.ConfirmationDanger"
                                   Disabled="IsBusy"
                                   IsLoading="IsBusy"
                                   Class="delete-confirmation__confirm-action"
                                   OnClick="ConfirmAsync">
                        @(ConfirmLabel ?? "Confirm")
                    </BeeDayButton>
                </div>
            </div>
        </section>
    </div>
}

<DialogFocusScope Active="@IsOpen"
                  TargetId="@DialogId"
                  InitialFocusSelector=".delete-confirmation__cancel-action" />

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Message { get; set; } = string.Empty;
    [Parameter] public string? ItemTitle { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? Warning { get; set; }
    [Parameter] public string? WarningDetails { get; set; }
    [Parameter] public string? ConfirmLabel { get; set; }
    [Parameter] public string? CancelLabel { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private readonly string _id = Guid.NewGuid().ToString("N");
    private string DialogId => $"beeday-confirm-dialog-{_id}";
    private string TitleId => $"beeday-confirm-title-{_id}";
    private string DescriptionId => $"beeday-confirm-description-{_id}";

    private Task ConfirmAsync() => IsBusy ? Task.CompletedTask : OnConfirm.InvokeAsync();
    private Task CancelAsync() => IsBusy ? Task.CompletedTask : OnCancel.InvokeAsync();

    private Task HandleKeyDownAsync(KeyboardEventArgs args) =>
        args.Key == "Escape" ? CancelAsync() : Task.CompletedTask;
}
