# Default text handling
* text=auto

# .NET, Blazor, configuration, documentation and scripts
*.cs text eol=crlf
*.razor text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.sln text eol=crlf
*.slnx text eol=crlf
*.json text eol=crlf
*.editorconfig text eol=crlf
*.config text eol=crlf
*.xml text eol=crlf
*.svg text eol=crlf
*.md text eol=crlf
*.txt text eol=crlf
*.css text eol=crlf
*.scss text eol=crlf
*.js text eol=crlf
*.ts text eol=crlf
*.yml text eol=crlf
*.yaml text eol=crlf

# Unix shell scripts retain LF for portability
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
